{
  "description": "Measure the two false-positive gates (quote-aware scoring, out-of-distribution abstention).",
  "model": "served v1 (ml/artifacts/clearcart_text_model.joblib), unchanged; text threshold tau = 0.68",
  "rules": {
    "quote_gate": "For an element that crossed the threshold: if it contains >= 1 quoted span (\"..\", “..”, ‘..’, '..'; mixed open/close marks allowed; an unclosed quote running to the end of the element counts; in-word apostrophes never open/close) AND >= 4 words of >= 2 letters remain after masking, score the text with every quoted span replaced by '…'. If the masked score is below the threshold, the element is not a finding; it is listed in uncertain_elements as 'quoted example — treated as a mention, not a claim'. Entirely-quoted or short elements are scored normally.",
    "quote_placeholder_selection": "'…' chosen on VALIDATION: appending each of 9 candidate placeholders to the 328 val texts, '…' moved P(dark) least (mean |Δ| 0.0011, 0 decision flips).",
    "quote_rule_revision": "First version required matching quote characters and a closing quote. On the About-page screenshot probe the OCR text had mismatched (' … ’) and cut-off quotes, so the rule was generalised to mixed marks and end-of-element unclosed quotes. This revision was made after looking at that probe (not at the TEST split); the TEST numbers below use the final rule.",
    "ood_gate": "max cosine similarity (MiniLM, L2-normalised) to the 1,645 TRAIN texts in the neighbour bank; an element that crossed the threshold is withheld as 'uncertain — unlike the training data' if similarity < tau_ood.",
    "ood_threshold": {
      "threshold": 0.3839946389198303,
      "rule": "largest value with <= 2% of validation dark rows strictly below it (3 of 161 rows; tau = sorted similarity #4)",
      "quantile": 0.02,
      "n_val_dark": 161,
      "n_val_dark_below": 3
    },
    "ood_threshold_quantile": 0.02,
    "ood_threshold_selection": "VALIDATION split only, fixed before any TEST evaluation: 2% (upper end of the 1–2% range) of validation DARK rows may fall below tau_ood. Applied unchanged to text, HTML and OCR.",
